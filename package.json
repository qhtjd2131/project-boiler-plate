{
  "name": "boiler-plate-v1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "node -e \"require('node:fs').rmSync('.next/dev/types',{ recursive: true, force: true })\" && next typegen && tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "provision:supabase": "tsx scripts/provision/supabase.ts",
    "provision:sanity": "tsx scripts/provision/sanity.ts",
    "provision:all": "pnpm run provision:supabase && pnpm run provision:sanity"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@sanity/client": "7.14.1",
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "2.95.3",
    "@tanstack/react-query": "5.90.20",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lodash-es": "4.17.23",
    "lucide-react": "0.563.0",
    "next": "16.1.6",
    "next-sanity": "12.1.0",
    "radix-ui": "1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "7.71.1",
    "sanity": "5.9.0",
    "tailwind-merge": "3.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/lodash-es": "4.17.12",
    "@types/node": "25.2.2",
    "@types/pg": "8.16.0",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "dotenv": "17.2.4",
    "eslint": "9.39.2",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "10.1.8",
    "pg": "8.18.0",
    "prettier": "3.8.1",
    "shadcn": "3.8.4",
    "tailwindcss": "4.1.18",
    "tsx": "4.21.0",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.29.2"
}

{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["opencode.md", "docs/client-reference.md"],
  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?read_only=true&project_ref={env:NEXT_PUBLIC_SUPABASE_PROJECT_ID}",
      "enabled": true
    },
    "sanity": {
      "type": "local",
      "command": ["npx", "-y", "@sanity/mcp-server@0.12.1"],
      "enabled": true,
      "environment": {
        "SANITY_PROJECT_ID": "{env:NEXT_PUBLIC_SANITY_PROJECT_ID}",
        "SANITY_DATASET": "{env:NEXT_PUBLIC_SANITY_DATASET}",
        "SANITY_API_TOKEN": "{env:SANITY_API_TOKEN}",
        "MCP_USER_ROLE": "developer"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "-y", "shadcn@3.8.4", "mcp"],
      "enabled": true
    }
  }
}

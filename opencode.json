{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["opencode.md"],
  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?read_only=true&project_ref={env:SUPABASE_PROJECT_REF}",
      "enabled": true
    },
    "directus": {
      "type": "local",
      "command": ["npx", "-y", "@directus/content-mcp@0.1.0"],
      "enabled": true,
      "environment": {
        "DIRECTUS_URL": "{env:DIRECTUS_URL}",
        "DIRECTUS_TOKEN": "{env:DIRECTUS_TOKEN}"
      }
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "-y", "shadcn@3.8.4", "mcp"],
      "enabled": true
    }
  }
}

# Backend feature flags
NEXT_PUBLIC_ENABLE_SUPABASE=false
NEXT_PUBLIC_ENABLE_DIRECTUS=false
NEXT_PUBLIC_ENABLE_GA=false
NEXT_PUBLIC_PRIMARY_BACKEND=supabase
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# i18n
# Supported locales are fixed in code: ko, en

# Supabase runtime
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase provisioning (for pnpm run provision:supabase)
SUPABASE_DB_URL=
SUPABASE_BRIEF_TABLE=project_briefs

# Directus runtime
DIRECTUS_URL=
DIRECTUS_TOKEN=
DIRECTUS_COLLECTION=project_briefs

# Directus provisioning (for pnpm run provision:directus)
DIRECTUS_ADMIN_TOKEN=

# Auth guard
AUTH_GUARD_ENABLED=true
AUTH_SIGN_IN_PATH=/auth/sign-in
AUTH_FORBIDDEN_PATH=/forbidden

# MCP helper values
SUPABASE_PROJECT_REF=

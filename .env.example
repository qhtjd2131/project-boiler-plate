# Backend feature flags
NEXT_PUBLIC_ENABLE_SUPABASE=false
NEXT_PUBLIC_ENABLE_SANITY=false
NEXT_PUBLIC_ENABLE_GA=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# i18n
# Default locales are defined in src/lib/i18n/config.ts (can be extended)

# Supabase runtime (operational DB/Auth/Storage)
NEXT_PUBLIC_SUPABASE_PROJECT_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Supabase provisioning (for pnpm run provision:supabase)
SUPABASE_DB_URL=
SUPABASE_BRIEF_TABLE=project_briefs

# Sanity runtime (public content CMS)
# Embedded studio route is controlled by NEXT_PUBLIC_SANITY_STUDIO_PATH
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19
NEXT_PUBLIC_SANITY_STUDIO_PATH=/admin
SANITY_API_TOKEN=

# Auth guard
AUTH_GUARD_ENABLED=true
AUTH_SIGN_IN_PATH=/auth/sign-in
AUTH_FORBIDDEN_PATH=/forbidden

# MCP helper values
